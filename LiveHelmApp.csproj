<Project Sdk="Microsoft.NET.Sdk">
  <!-- LiveHelm-App: programa WPF em .NET Framework 4.8 (já vem no Windows 10/11, então o .exe não exige nada instalado). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AssemblyName>LiveHelm-App</AssemblyName>
    <RootNamespace>LiveHelmApp</RootNamespace>
    <ApplicationIcon>icone.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Resource Include="icone.png" />
  </ItemGroup>
</Project>
