<Window x:Class="LiveHelmApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LiveHelmApp"
        xml:lang="pt-BR"
        Title="LiveHelm-App" Width="1120" Height="780" MinWidth="340" MinHeight="420"
        Background="{DynamicResource Fundo}" Foreground="{StaticResource Texto}" Icon="icone.png"
        FontFamily="Segoe UI" UseLayoutRounding="True" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisivel" />
        <local:TextoParaPincel x:Key="PincelDe" />

        <!-- Item de conexão (barra e popup). -->
        <DataTemplate x:Key="ModeloDeConexao">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                <Ellipse Width="8" Height="8" Fill="{Binding Cor, Converter={StaticResource PincelDe}}" VerticalAlignment="Center" Margin="0,1,8,0" />
                <TextBlock Text="{Binding Nome}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Detalhe}" Foreground="{StaticResource Suave}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <!-- Cena do OBS: botão pequeno; a do ar acende em roxo. -->
        <Style x:Key="BotaoDeCena" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="13" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Atual}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Acento}" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                    <Setter Property="BorderThickness" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Lista do chat: sem seleção chamativa; a rolagem é nossa pra poder seguir o fim. -->
        <Style x:Key="ListaDoChat" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer x:Name="Rolagem" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ContextMenu x:Key="MenuDaMensagem" Opened="MenuDaMensagem_Opened">
            <MenuItem Header="Mencionar" Tag="msg" Click="MenuMencionar_Click" />
            <MenuItem Header="Copiar mensagem" Tag="copiar" Click="MenuCopiar_Click" />
            <Separator />
            <MenuItem Header="Fixar mensagem" Tag="msg" Click="MenuFixar_Click" />
            <MenuItem Header="Marcar como pergunta" Tag="msg" Click="MenuPergunta_Click" />
            <MenuItem Header="Ver só este usuário" Tag="msg" Click="MenuUsuario_Click" />
            <Separator />
            <MenuItem Header="Apagar mensagem" Tag="msg" Click="MenuApagar_Click" />
            <MenuItem Header="Silenciar por 1 minuto" Tag="msg" Click="MenuSilenciar1_Click" />
            <MenuItem Header="Silenciar por 10 minutos" Tag="msg" Click="MenuSilenciar10_Click" />
            <MenuItem Header="Banir" Tag="msg" Click="MenuBanir_Click" />
        </ContextMenu>
        <Style x:Key="ItemDoChat" TargetType="ListBoxItem">
            <Setter Property="ContextMenu" Value="{StaticResource MenuDaMensagem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Fundo" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo" Property="Background" Value="#0FFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate DataType="{x:Type local:ItemChat}">
            <Border x:Name="Linha" Padding="4,3,8,3" BorderThickness="3,0,0,0" BorderBrush="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{DynamicResource LarguraRapidas}" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Banir, silenciar 5 min e apagar: ao lado esquerdo do nome, só com o mouse na mensagem. -->
                    <StackPanel x:Name="Rapidas" Orientation="Horizontal" VerticalAlignment="Top" Opacity="0" ClipToBounds="True">
                        <Button Style="{StaticResource BotaoIconeLinha}" ToolTip="Banir" Click="RapidaBanir_Click">
                            <Path Data="{StaticResource IconeBanir}" Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.8" StrokeLineJoin="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button Style="{StaticResource BotaoIconeLinha}" ToolTip="Silenciar por 5 minutos" Click="RapidaTempo_Click">
                            <Path Data="{StaticResource IconeTempo}" Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.8" StrokeLineJoin="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button x:Name="BotaoApagar" Style="{StaticResource BotaoIconeLinha}" ToolTip="Apagar mensagem" Click="RapidaApagar_Click">
                            <Path Data="{StaticResource IconeLixeira}" Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.8" StrokeLineJoin="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>
                    <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="13.5" local:ChatTexto.Item="{Binding}" />
                    <Button x:Name="Mais" Grid.Column="2" Style="{StaticResource BotaoIconeLinha}" Content="⋮" FontSize="16" FontWeight="Bold" VerticalAlignment="Top"
                            ToolTip="Mais opções" Opacity="0" Click="Mais_Click" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Linha" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Rapidas" Property="Opacity" Value="1" />
                    <Setter TargetName="Mais" Property="Opacity" Value="1" />
                </Trigger>
                <DataTrigger Binding="{Binding EhAlerta}" Value="True">
                    <Setter TargetName="Linha" Property="Background" Value="#14FFFFFF" />
                    <Setter TargetName="Linha" Property="BorderBrush" Value="{Binding CorPlataforma, Converter={StaticResource PincelDe}}" />
                    <Setter TargetName="Rapidas" Property="Visibility" Value="Hidden" />
                    <Setter TargetName="Mais" Property="Visibility" Value="Hidden" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Primeira}" Value="True">
                    <Setter TargetName="Linha" Property="Background" Value="#0FFFFFFF" />
                    <Setter TargetName="Linha" Property="BorderBrush" Value="{Binding CorPlataforma, Converter={StaticResource PincelDe}}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PodeApagar}" Value="False">
                    <Setter TargetName="BotaoApagar" Property="IsEnabled" Value="False" />
                    <Setter TargetName="BotaoApagar" Property="ToolTip" Value="O YouTube não permite apagar mensagens" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Apagada}" Value="True">
                    <Setter TargetName="Linha" Property="Opacity" Value="0.5" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
    <Border Padding="14,10,14,14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Barra de cima: logo e plataformas ativas à esquerda; chaves dos painéis no meio; conexões, configurações e ajuda à direita. -->
            <Grid x:Name="BarraTopo" Grid.Row="0" Margin="2,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- Plataformas ativas: valem pra tudo (atualizar live, enviar mensagem, comandos, enquetes). O globo liga ou desliga todas. -->
                <StackPanel x:Name="GrupoPlataformas" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="BtnMundo" Style="{StaticResource BotaoPlano}" Width="34" Height="32" Padding="0" Margin="0,0,6,0" Click="Mundo_Click">
                        <Path Data="{StaticResource IconeGlobo}" Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.7" StrokeLineJoin="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <CheckBox x:Name="ChkTwitch" Tag="#9146FF" Style="{StaticResource IconeDePlataforma}" Margin="0,0,6,0" Checked="Plataforma_Changed" Unchecked="Plataforma_Changed">
                        <Path Data="{StaticResource IconeTwitch}" Width="14" Height="14" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}" />
                    </CheckBox>
                    <CheckBox x:Name="ChkKick" Tag="#53FC18" Style="{StaticResource IconeDePlataforma}" Margin="0,0,6,0" Checked="Plataforma_Changed" Unchecked="Plataforma_Changed">
                        <Path Data="{StaticResource IconeKick}" Width="14" Height="14" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}" />
                    </CheckBox>
                    <CheckBox x:Name="ChkYouTube" Tag="#FF3B3B" Style="{StaticResource IconeDePlataforma}" Checked="Plataforma_Changed" Unchecked="Plataforma_Changed">
                        <Path Data="{StaticResource IconeYouTube}" Width="16" Height="16" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}" />
                    </CheckBox>
                </StackPanel>

                <!-- Painéis: cada chave mostra ou esconde o painel inteiro. -->
                <WrapPanel x:Name="GrupoPaineis" Grid.Column="2" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkVerLive" Content="Live" Style="{StaticResource ChipDePainel}" Checked="Visivel_Changed" Unchecked="Visivel_Changed" />
                    <CheckBox x:Name="ChkVerObs" Content="Cenas" Style="{StaticResource ChipDePainel}" Checked="Visivel_Changed" Unchecked="Visivel_Changed" />
                    <CheckBox x:Name="ChkVerSaude" Content="Saúde" Style="{StaticResource ChipDePainel}" Checked="Visivel_Changed" Unchecked="Visivel_Changed" />
                    <CheckBox x:Name="ChkVerMomento" Content="Momento" Style="{StaticResource ChipDePainel}" Checked="Visivel_Changed" Unchecked="Visivel_Changed" />
                    <CheckBox x:Name="ChkVerInter" Content="Enquetes" Style="{StaticResource ChipDePainel}" Checked="Visivel_Changed" Unchecked="Visivel_Changed" />
                    <CheckBox x:Name="ChkVerChat" Content="Chat" Style="{StaticResource ChipDePainel}" Checked="Visivel_Changed" Unchecked="Visivel_Changed" />
                </WrapPanel>

                <StackPanel x:Name="GrupoDireita" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtAoVivo" Foreground="#FF6B6B" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ItemsControl x:Name="ChipsFixos" Visibility="Collapsed" ItemTemplate="{StaticResource ModeloDeConexao}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="0,0,14,0" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                    <Border x:Name="PontoConexoes" Width="30" Height="30" Background="Transparent" Cursor="Hand"
                            MouseEnter="Ponto_MouseEnter" MouseLeave="Ponto_MouseLeave">
                        <Ellipse x:Name="BolinhaGeral" Width="12" Height="12" Fill="#6B6580" />
                    </Border>
                    <Popup x:Name="PopupConexoes" PlacementTarget="{Binding ElementName=PontoConexoes}" Placement="Bottom"
                           StaysOpen="True" AllowsTransparency="True">
                        <Border x:Name="CartaoConexoes" Style="{StaticResource EstiloCartao}" Background="{DynamicResource Elevado}"
                                BorderBrush="{StaticResource BordaForte}" Margin="8" Padding="14,12" MinWidth="230"
                                MouseEnter="Ponto_MouseEnter" MouseLeave="Ponto_MouseLeave">
                            <StackPanel>
                                <ItemsControl x:Name="ListaConexoes" ItemTemplate="{StaticResource ModeloDeConexao}">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Margin" Value="0,0,0,8" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                </ItemsControl>
                                <Button x:Name="BtnFixar" Content="Mostrar sempre na barra" Style="{StaticResource BotaoPlano}"
                                        Foreground="{DynamicResource AcentoClaro}" HorizontalAlignment="Left" Margin="-10,2,0,-4" Click="Fixar_Click" />
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Button Width="28" Height="28" Padding="0" Style="{StaticResource BotaoPlano}" Foreground="{StaticResource Suave}" ToolTip="Configurações"
                            Click="Config_Click" Margin="2,0,0,0">
                        <Path Data="{StaticResource IconeEngrenagem}" Width="17" Height="17" Stretch="Uniform" StrokeThickness="1.7" StrokeLineJoin="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Content="?" Width="28" Height="28" Padding="0" Style="{StaticResource BotaoPlano}" FontSize="13"
                            Foreground="{StaticResource Suave}" ToolTip="Como criar as ações no Streamer.bot" Click="Ajuda_Click" />
                </StackPanel>
            </Grid>

            <!-- Painéis: cada um recolhe até o título; o chat ocupa o que sobrar. -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="LinhaLive" Height="Auto" />
                    <RowDefinition x:Name="LinhaObs" Height="Auto" />
                    <RowDefinition x:Name="LinhaSaude" Height="Auto" />
                    <RowDefinition x:Name="LinhaMomento" Height="Auto" />
                    <RowDefinition x:Name="LinhaInter" Height="Auto" />
                    <RowDefinition x:Name="LinhaChat" Height="*" />
                </Grid.RowDefinitions>

                <!-- Live: título, categoria e onde atualizar. -->
                <Border x:Name="PainelLive" Grid.Row="0" Style="{StaticResource EstiloCartao}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Height="38" Background="Transparent" Cursor="Hand" Tag="live" MouseLeftButtonUp="Cabecalho_Click">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SetaLive" Text="▾" Foreground="{StaticResource Suave}" Margin="14,0,8,1" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Live" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock x:Name="ResumoLive" Grid.Column="2" Foreground="{StaticResource Suave}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                       Margin="12,0,12,0" VerticalAlignment="Center" />
                            <Button Grid.Column="3" Content="⤢" Tag="live" Style="{StaticResource BotaoPlano}" Foreground="{StaticResource Suave}"
                                    ToolTip="Dar foco a este painel" Click="Focar_Click" Margin="0,0,8,0" />
                        </Grid>
                        <StackPanel x:Name="ConteudoLive" Grid.Row="1" Margin="14,0,14,14">
                            <Grid x:Name="GradeLive">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox x:Name="TxtTitulo" Grid.Column="0" Tag="Título da live" SpellCheck.IsEnabled="True" Padding="10,7,40,7"
                                         KeyDown="Campo_KeyDown" TextChanged="Campo_TextChanged" />
                                <Button x:Name="BtnEmoji" Grid.Column="0" Content="😀" FontFamily="Segoe UI Emoji" FontSize="15" Style="{StaticResource BotaoPlano}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Width="32" Height="28" Padding="0" Margin="0,0,3,0"
                                        ToolTip="Emojis (abre o seletor do Windows, Win + .)" Click="Emoji_Click" />
                                <TextBox x:Name="TxtCategoria" Grid.Column="2" Tag="Categoria ou jogo" SpellCheck.IsEnabled="True"
                                         KeyDown="Categoria_KeyDown" TextChanged="Categoria_TextChanged" GotKeyboardFocus="Categoria_Foco" />
                                <Popup x:Name="PopupSugestoes" PlacementTarget="{Binding ElementName=TxtCategoria}" Placement="Bottom"
                                       StaysOpen="False" AllowsTransparency="True">
                                    <Border Style="{StaticResource EstiloCartao}" Background="{DynamicResource Elevado}" BorderBrush="{StaticResource BordaForte}"
                                            Margin="0,4,8,8" Padding="4" MinWidth="220">
                                        <ListBox x:Name="ListaSugestoes" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Texto}"
                                                 MaxHeight="190" SelectionChanged="Sugestao_Escolhida" />
                                    </Border>
                                </Popup>
                                <Button x:Name="BtnAtualizar" Grid.Column="4" Content="Confirmar" Style="{StaticResource BotaoPrincipal}" Height="32"
                                        Click="Atualizar_Click" />
                            </Grid>

                            <!-- Atalhos: só categorias, um clique carrega. -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <TextBlock x:Name="VazioAtalhos" Text="Salve categorias para trocar com um clique." Foreground="{StaticResource Suave}"
                                               FontSize="12.5" VerticalAlignment="Center" />
                                    <ItemsControl x:Name="ListaAtalhos">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource Elevado}" BorderBrush="{StaticResource Borda}" BorderThickness="1"
                                                        CornerRadius="13" Margin="0,0,6,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Style="{StaticResource BotaoPlano}" Content="{Binding}" Tag="{Binding}" Click="Atalho_Click"
                                                                Padding="11,3,4,3" />
                                                        <Button Style="{StaticResource BotaoPlano}" Content="✕" FontSize="10" Tag="{Binding}" Foreground="{StaticResource Suave}"
                                                                ToolTip="Remover" Click="RemoverAtalho_Click" Padding="4,3,9,3" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                                <Button Grid.Column="1" Content="+ Salvar categoria" Style="{StaticResource BotaoPlano}" Foreground="{DynamicResource AcentoClaro}"
                                        VerticalAlignment="Top" Margin="8,-2,-8,0" Click="SalvarAtalho_Click" />
                            </Grid>

                            <TextBlock x:Name="StatusEnvio" TextWrapping="Wrap" FontSize="12.5" Margin="0,8,0,0" Visibility="Collapsed" />
                            <StackPanel x:Name="AvisosLive" Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock x:Name="AvisoSb" Foreground="{StaticResource Aviso}" FontSize="12.5" VerticalAlignment="Center"
                                           Text="Streamer.bot desconectado: abra-o e ligue o WebSocket Server." />
                                <Button x:Name="BtnFaltam" Style="{StaticResource BotaoPlano}" Foreground="{StaticResource Aviso}" Click="Ajuda_Click"
                                        Visibility="Collapsed" Padding="8,2" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- OBS: cenas em botões pequenos. -->
                <Border x:Name="PainelObs" Grid.Row="1" Style="{StaticResource EstiloCartao}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Height="38" Background="Transparent" Cursor="Hand" Tag="obs" MouseLeftButtonUp="Cabecalho_Click">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SetaObs" Text="▾" Foreground="{StaticResource Suave}" Margin="14,0,8,1" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Cenas" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock x:Name="ResumoObs" Grid.Column="2" Foreground="{StaticResource Suave}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                       Margin="12,0,12,0" VerticalAlignment="Center" />
                            <Button Grid.Column="4" Content="⤢" Tag="obs" Style="{StaticResource BotaoPlano}" Foreground="{StaticResource Suave}"
                                    ToolTip="Dar foco a este painel" Click="Focar_Click" Margin="0,0,8,0" />
                        </Grid>
                        <StackPanel x:Name="ConteudoObs" Grid.Row="1" Margin="14,0,14,8">
                            <ItemsControl x:Name="ListaCenas">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding Nome}" Style="{StaticResource BotaoDeCena}" Click="Cena_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Fill="#FFFFFF" Margin="0,1,7,0" VerticalAlignment="Center"
                                                         Visibility="{Binding Atual, Converter={StaticResource BoolParaVisivel}}" />
                                                <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="ObsVazio" Foreground="{StaticResource Suave}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <Button x:Name="BtnConfigObs" Content="Abrir configurações do OBS" Style="{StaticResource BotaoPlano}" Foreground="{DynamicResource AcentoClaro}"
                                    HorizontalAlignment="Left" Margin="-10,0,0,6" Click="Config_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Saúde da transmissão: CPU, FPS e quadros perdidos do OBS (e, se ligados nas configurações, iniciar e encerrar a live e a gravação). -->
                <Border x:Name="PainelSaude" Grid.Row="2" Style="{StaticResource EstiloCartao}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Height="38" Background="Transparent" Cursor="Hand" Tag="saude" MouseLeftButtonUp="Cabecalho_Click">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SetaSaude" Text="▾" Foreground="{StaticResource Suave}" Margin="14,0,8,1" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Saúde da transmissão" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock x:Name="ResumoSaude" Grid.Column="2" Foreground="{StaticResource Suave}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                       Margin="12,0,12,0" VerticalAlignment="Center" />
                            <Button Grid.Column="3" Content="⤢" Tag="saude" Style="{StaticResource BotaoPlano}" Foreground="{StaticResource Suave}"
                                    ToolTip="Dar foco a este painel" Click="Focar_Click" Margin="0,0,8,0" />
                        </Grid>
                        <StackPanel x:Name="ConteudoSaude" Grid.Row="1" Margin="14,0,14,8">
                            <ItemsControl x:Name="ListaSaude">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Elevado}" BorderBrush="{StaticResource Borda}" BorderThickness="1" CornerRadius="8"
                                                Padding="10,5" Margin="0,0,6,6" ToolTip="{Binding Dica}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Fill="{Binding Cor, Converter={StaticResource PincelDe}}" VerticalAlignment="Center" Margin="0,1,8,0" />
                                                <TextBlock Text="{Binding Nome}" Foreground="{StaticResource Suave}" FontSize="12.5" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Valor}" FontWeight="SemiBold" FontSize="12.5" Margin="7,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="SaudeVazia" Foreground="{StaticResource Suave}" FontSize="12.5" TextWrapping="Wrap" Text="Conecte o OBS para ver CPU, FPS e quadros perdidos." />

                            <!-- Iniciar e encerrar: só aparecem se ligados nas configurações. -->
                            <WrapPanel x:Name="SecaoTransmissao" Margin="0,8,0,0" Visibility="Collapsed">
                                <Button x:Name="BtnLive" Content="Iniciar live" Margin="0,0,8,0" Padding="14,6" Click="Live_Click" />
                                <Button x:Name="BtnGravacao" Content="Iniciar gravação" Margin="0,0,8,0" Padding="14,6" Click="Gravacao_Click" />
                            </WrapPanel>
                            <TextBlock x:Name="StatusSaude" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Momento: marca o tempo da live com uma anotação num arquivo de texto. -->
                <Border x:Name="PainelMomento" Grid.Row="3" Style="{StaticResource EstiloCartao}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Height="38" Background="Transparent" Cursor="Hand" Tag="momento" MouseLeftButtonUp="Cabecalho_Click">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SetaMomento" Text="▾" Foreground="{StaticResource Suave}" Margin="14,0,8,1" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Momento" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="⤢" Tag="momento" Style="{StaticResource BotaoPlano}" Foreground="{StaticResource Suave}"
                                    ToolTip="Dar foco a este painel" Click="Focar_Click" Margin="0,0,8,0" />
                        </Grid>
                        <StackPanel x:Name="ConteudoMomento" Grid.Row="1" Margin="14,0,14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtMomento" Tag="Marcar momento (ex.: boss)" SpellCheck.IsEnabled="True" KeyDown="Momento_KeyDown" />
                                <Button x:Name="BtnMarcar" Grid.Column="2" Content="Marcar" Style="{StaticResource BotaoPrincipal}" Height="32" Click="Marcar_Click"
                                        ToolTip="Grava o tempo da live e a anotação no arquivo de momentos do dia" />
                                <Button Grid.Column="4" Content="Abrir" Style="{StaticResource BotaoPlano}" Foreground="{DynamicResource AcentoClaro}"
                                        ToolTip="Abre o arquivo de momentos de hoje" Click="AbrirMomentos_Click" />
                            </Grid>
                            <TextBlock x:Name="StatusMomento" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Enquetes e previsões da Twitch: iniciar, atalhos e controle da que está no ar. -->
                <Border x:Name="PainelInter" Grid.Row="4" Style="{StaticResource EstiloCartao}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Height="38" Background="Transparent" Cursor="Hand" Tag="inter" MouseLeftButtonUp="Cabecalho_Click">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SetaInter" Text="▾" Foreground="{StaticResource Suave}" Margin="14,0,8,1" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Enquetes e previsões" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock x:Name="ResumoInter" Grid.Column="2" Foreground="{StaticResource Suave}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                       Margin="12,0,12,0" VerticalAlignment="Center" />
                            <Button Grid.Column="3" Content="⤢" Tag="inter" Style="{StaticResource BotaoPlano}" Foreground="{StaticResource Suave}"
                                    ToolTip="Dar foco a este painel" Click="Focar_Click" Margin="0,0,8,0" />
                        </Grid>
                        <StackPanel x:Name="ConteudoInter" Grid.Row="1" Margin="14,0,14,14">
                            <Grid x:Name="GradeInter">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Background="{DynamicResource Campo}" BorderBrush="{StaticResource Borda}" BorderThickness="1" CornerRadius="8" Padding="3" Height="34" x:Name="SegInter">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="TipoEnquete" Content="Enquete" Style="{StaticResource Segmento}" GroupName="tipoInter" IsChecked="True" Checked="TipoInter_Checked" />
                                        <RadioButton x:Name="TipoPrevisao" Content="Previsão" Style="{StaticResource Segmento}" GroupName="tipoInter" Checked="TipoInter_Checked" />
                                    </StackPanel>
                                </Border>
                                <TextBox x:Name="TxtPergunta" Grid.Column="2" Tag="Pergunta" SpellCheck.IsEnabled="True" KeyDown="Inter_KeyDown" />
                                <TextBox x:Name="TxtOpcoes" Grid.Column="4" Tag="Opções separadas por |" SpellCheck.IsEnabled="True" KeyDown="Inter_KeyDown" />
                                <TextBox x:Name="TxtDuracao" Grid.Column="6" Tag="seg" ToolTip="Duração em segundos" KeyDown="Inter_KeyDown" />
                                <Button x:Name="BtnIniciar" Grid.Column="8" Content="Iniciar" Style="{StaticResource BotaoPrincipal}" Height="32" Click="Iniciar_Click" />
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <ItemsControl x:Name="ListaInteracoes">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource Elevado}" BorderBrush="{StaticResource Borda}" BorderThickness="1" CornerRadius="13" Margin="0,0,6,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Style="{StaticResource BotaoPlano}" Tag="{Binding}" Click="CarregarInteracao_Click"
                                                                ToolTip="{Binding Rotulo}" Padding="11,3,4,3">
                                                            <TextBlock Text="{Binding Rotulo}" TextTrimming="CharacterEllipsis" MaxWidth="230" />
                                                        </Button>
                                                        <Button Style="{StaticResource BotaoPlano}" Content="▶" FontSize="10" Tag="{Binding}" Foreground="{DynamicResource AcentoClaro}"
                                                                ToolTip="Iniciar agora" Click="IniciarSalva_Click" Padding="5,3" />
                                                        <Button Style="{StaticResource BotaoPlano}" Content="✕" FontSize="10" Tag="{Binding}" Foreground="{StaticResource Suave}"
                                                                ToolTip="Remover" Click="RemoverInteracao_Click" Padding="4,3,9,3" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Grid>
                            <TextBlock x:Name="StatusInter" FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
                            <Border x:Name="CartaoInteracao" Visibility="Collapsed" Margin="0,10,0,0" Padding="12,10" CornerRadius="10"
                                    Background="{DynamicResource AcentoFundo}" BorderBrush="{DynamicResource AcentoBorda}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock x:Name="TxtInteracao" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <WrapPanel x:Name="BotoesInteracao" Margin="0,8,0,-6" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Chat: mensagens e alertas juntos, com moderação e envio. -->
                <Border x:Name="PainelChat" Grid.Row="5" Style="{StaticResource EstiloCartao}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Height="38" Background="Transparent" Cursor="Hand" Tag="chat" MouseLeftButtonUp="Cabecalho_Click">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SetaChat" Text="▾" Foreground="{StaticResource Suave}" Margin="14,0,8,1" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Chat" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock x:Name="ResumoChat" Grid.Column="2" Foreground="{StaticResource Suave}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                       Margin="12,0,12,0" VerticalAlignment="Center" />
                            <StackPanel x:Name="FiltrosChat" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                <RadioButton x:Name="FiltroTudo" Tag="tudo" Style="{StaticResource AbaDoChat}" BorderBrush="{DynamicResource Acento}" Background="{DynamicResource AcentoAba}" GroupName="filtro" Checked="Filtro_Checked"
                                             ToolTip="Tudo: mostra todas as plataformas e envia para as ativas no alto">
                                    <Path Data="{StaticResource IconeGlobo}" Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.6" StrokeLineJoin="Round"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </RadioButton>
                                <RadioButton x:Name="FiltroTwitch" Tag="twitch" Style="{StaticResource AbaDoChat}" BorderBrush="#9146FF" Background="#339146FF" GroupName="filtro" Checked="Filtro_Checked"
                                             ToolTip="Só a Twitch: mostra e envia só para ela">
                                    <Path Data="{StaticResource IconeTwitch}" Width="13" Height="13" Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </RadioButton>
                                <RadioButton x:Name="FiltroKick" Tag="kick" Style="{StaticResource AbaDoChat}" BorderBrush="#53FC18" Background="#3353FC18" GroupName="filtro" Checked="Filtro_Checked"
                                             ToolTip="Só a Kick: mostra e envia só para ela">
                                    <Path Data="{StaticResource IconeKick}" Width="13" Height="13" Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </RadioButton>
                                <RadioButton x:Name="FiltroYouTube" Tag="youtube" Style="{StaticResource AbaDoChat}" BorderBrush="#FF3B3B" Background="#33FF3B3B" GroupName="filtro" Checked="Filtro_Checked"
                                             ToolTip="Só o YouTube: mostra e envia só para ele">
                                    <Path Data="{StaticResource IconeYouTube}" Width="15" Height="15" Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </RadioButton>
                                <RadioButton x:Name="FiltroAlertas" Content="Alertas" Tag="alertas" Style="{StaticResource AbaDoChat}" BorderBrush="{DynamicResource Acento}" Background="{DynamicResource AcentoAba}" GroupName="filtro" Checked="Filtro_Checked"
                                             ToolTip="Alertas de todas as plataformas" />
                                <RadioButton x:Name="FiltroPerguntas" Tag="perguntas" Style="{StaticResource AbaDoChat}" BorderBrush="{DynamicResource Acento}" Background="{DynamicResource AcentoAba}" GroupName="filtro" Checked="Filtro_Checked"
                                             ToolTip="Perguntas: fila das mensagens marcadas pra responder depois">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconePergunta}" Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.6" StrokeLineJoin="Round"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                        <TextBlock x:Name="TxtContaPerguntas" FontSize="12" Margin="5,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                            <Button x:Name="BtnBuscar" Grid.Column="4" Style="{StaticResource BotaoPlano}" Foreground="{StaticResource Suave}" Width="28" Height="28" Padding="0"
                                    ToolTip="Buscar no chat (Ctrl+F)" Click="Buscar_Click">
                                <Path Data="{StaticResource IconeLupa}" Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                            <Button x:Name="BtnPunicoes" Grid.Column="5" Style="{StaticResource BotaoPlano}" Foreground="{StaticResource Suave}" Padding="6,0" Height="28"
                                    ToolTip="Silenciados e banidos desta sessão" Click="Punicoes_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconeBanir}" Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.7" StrokeLineJoin="Round"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock x:Name="TxtPunicoes" FontSize="12" Margin="5,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                </StackPanel>
                            </Button>
                            <Popup x:Name="PopupPunicoes" PlacementTarget="{Binding ElementName=BtnPunicoes}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                <Border x:Name="CartaoPunicoes" Style="{StaticResource EstiloCartao}" Background="{DynamicResource Elevado}" BorderBrush="{StaticResource BordaForte}" Margin="8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Silenciados e banidos nesta sessão" FontWeight="Bold" FontSize="13.5" Margin="0,0,0,8" />
                                        <TextBlock x:Name="PunicoesVazias" Foreground="{StaticResource Suave}" FontSize="12.5" TextWrapping="Wrap"
                                                   Text="Ninguém foi silenciado ou banido ainda. Aparecem aqui os silêncios e banimentos feitos pelo painel e os avisados pelas plataformas." />
                                        <ItemsControl x:Name="ListaPunicoes" MaxHeight="300">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Path Data="{Binding IconePlataforma}" Fill="{Binding CorPlataforma, Converter={StaticResource PincelDe}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Descricao}" Foreground="{StaticResource Suave}" FontSize="12" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Content="{Binding TextoBotao}" IsEnabled="{Binding PodeReverter}" Click="ReverterPunicao_Click" Padding="12,4" ToolTip="{Binding DicaBotao}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Popup>
                            <Button Grid.Column="6" Content="⤢" Tag="chat" Style="{StaticResource BotaoPlano}" Foreground="{StaticResource Suave}"
                                    ToolTip="Dar foco a este painel" Click="Focar_Click" Margin="0,0,8,0" />
                        </Grid>
                        <Grid x:Name="ConteudoChat" Grid.Row="1" Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- Busca no chat e filtro por usuário. -->
                            <Grid x:Name="BarraBusca" Grid.Row="0" Margin="14,0,14,10" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtBusca" Tag="Buscar por nome ou texto" TextChanged="Busca_TextChanged" KeyDown="Busca_KeyDown" />
                                <Border x:Name="ChipUsuario" Grid.Column="1" Visibility="Collapsed" Margin="8,0,0,0" Background="{DynamicResource AcentoFundo}" BorderBrush="{DynamicResource AcentoBorda}"
                                        BorderThickness="1" CornerRadius="8" Padding="10,0,2,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TxtChipUsuario" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" />
                                        <Button Style="{StaticResource BotaoPlano}" Content="✕" FontSize="10" Foreground="{StaticResource Suave}" ToolTip="Ver todos de novo" Click="LimparUsuario_Click" Padding="6,3" />
                                    </StackPanel>
                                </Border>
                                <Button Grid.Column="2" Content="Fechar" Style="{StaticResource BotaoPlano}" Foreground="{StaticResource Suave}" Margin="4,0,0,0" ToolTip="Fecha a busca e limpa os filtros (Esc)" Click="FecharBusca_Click" />
                            </Grid>
                            <!-- Mensagens fixadas. -->
                            <Border x:Name="BarraFixadas" Grid.Row="1" Visibility="Collapsed" Margin="14,0,14,10" Padding="10,6" CornerRadius="8"
                                    Background="{DynamicResource AcentoFundo}" BorderBrush="{DynamicResource AcentoBorda}" BorderThickness="1">
                                <ItemsControl x:Name="ListaFixadas">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Path Data="{StaticResource IconeFixar}" Width="13" Height="13" Stretch="Uniform" StrokeThickness="1.6" StrokeLineJoin="Round" Stroke="{DynamicResource AcentoClaro}" Margin="0,0,8,0" VerticalAlignment="Top" />
                                                <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="13" ToolTip="{Binding Texto}">
                                                    <Run Text="{Binding Nome, Mode=OneWay}" FontWeight="Bold" /><Run Text=": " /><Run Text="{Binding Texto, Mode=OneWay}" />
                                                </TextBlock>
                                                <Button Grid.Column="2" Style="{StaticResource BotaoPlano}" Content="✕" FontSize="10" Foreground="{StaticResource Suave}" ToolTip="Desafixar" Click="Desafixar_Click" Padding="6,2" VerticalAlignment="Top" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <Border Grid.Row="2" BorderBrush="{StaticResource Borda}" BorderThickness="0,1,0,1" Background="{DynamicResource FundoChat}">
                                <Grid>
                                    <ListBox x:Name="ListaChat" Style="{StaticResource ListaDoChat}" ItemContainerStyle="{StaticResource ItemDoChat}" />
                                    <TextBlock x:Name="ChatVazio" Foreground="{StaticResource Suave}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Text="As mensagens e os alertas das três plataformas aparecem aqui." />
                                    <Button x:Name="BtnNovas" Content="Novas mensagens ↓" Style="{StaticResource BotaoPrincipal}" Padding="14,5" FontSize="12.5"
                                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" Visibility="Collapsed" Click="Novas_Click" />
                                    <!-- Fila de perguntas (aba Perguntas): no lugar da lista de mensagens. -->
                                    <Grid x:Name="PainelPerguntas" Background="{DynamicResource FundoChat}" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid Margin="14,8,10,4">
                                            <TextBlock x:Name="TxtResumoPerguntas" Foreground="{StaticResource Suave}" FontSize="12.5" VerticalAlignment="Center" />
                                            <Button Content="Limpar respondidas" HorizontalAlignment="Right" Style="{StaticResource BotaoPlano}" Foreground="{DynamicResource AcentoClaro}" Click="LimparRespondidas_Click" />
                                        </Grid>
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl x:Name="ListaPerguntas" Margin="6,0,6,8">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="Cartao" Margin="0,0,0,6" Padding="10,8" CornerRadius="8" Background="{DynamicResource Elevado}" BorderBrush="{StaticResource Borda}" BorderThickness="1">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Path Data="{Binding IconePlataforma}" Fill="{Binding CorPlataforma, Converter={StaticResource PincelDe}}" Width="13" Height="13" Stretch="Uniform" Margin="0,3,10,0" VerticalAlignment="Top" />
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock TextWrapping="Wrap" FontSize="13.5">
                                                                        <Run Text="{Binding Nome, Mode=OneWay}" FontWeight="Bold" /><Run Text="  " /><Run Text="{Binding Hora, Mode=OneWay}" Foreground="{StaticResource Suave}" FontSize="11.5" />
                                                                    </TextBlock>
                                                                    <TextBlock Text="{Binding Texto}" TextWrapping="Wrap" FontSize="13.5" Margin="0,2,0,0" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                                                    <Button Style="{StaticResource BotaoPlano}" Content="{Binding TextoRespondida}" Click="PerguntaRespondida_Click" Foreground="{DynamicResource AcentoClaro}" ToolTip="Marcar ou desmarcar como respondida" />
                                                                    <Button Style="{StaticResource BotaoPlano}" Content="@" ToolTip="Mencionar na caixa de mensagem" Click="PerguntaMencionar_Click" Foreground="{StaticResource Suave}" Padding="8,5" />
                                                                    <Button Style="{StaticResource BotaoPlano}" Content="✕" FontSize="10" ToolTip="Remover da fila" Click="PerguntaRemover_Click" Foreground="{StaticResource Suave}" Padding="8,5" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Respondida}" Value="True">
                                                                <Setter TargetName="Cartao" Property="Opacity" Value="0.5" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <TextBlock x:Name="PerguntasVazias" Grid.Row="1" Foreground="{StaticResource Suave}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                                   TextWrapping="Wrap" Margin="24,0" Text="Nenhuma pergunta na fila. Clique com o botão direito numa mensagem e escolha “Marcar como pergunta”." />
                                    </Grid>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="StatusChat" Grid.Row="3" FontSize="12.5" Foreground="{StaticResource Aviso}" Margin="14,8,14,0"
                                       TextWrapping="Wrap" Visibility="Collapsed" />
                            <Grid Grid.Row="4" Margin="14,10,14,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtMensagem" Tag="Mensagem" SpellCheck.IsEnabled="True" KeyDown="Mensagem_KeyDown" TextChanged="Mensagem_TextChanged" />
                                <Popup x:Name="PopupComandos" PlacementTarget="{Binding ElementName=TxtMensagem}" Placement="Top" StaysOpen="False" AllowsTransparency="True">
                                    <Border Style="{StaticResource EstiloCartao}" Background="{DynamicResource Elevado}" BorderBrush="{StaticResource BordaForte}"
                                            Margin="0,8,8,4" Padding="4" MinWidth="320">
                                        <ListBox x:Name="ListaComandos" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Texto}"
                                                 SelectionChanged="Comando_Escolhido">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="4,2">
                                                        <TextBlock Text="{Binding Texto}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Descricao}" Foreground="{StaticResource Suave}" FontSize="12" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </Popup>
                                <Button x:Name="BtnEnviar" Grid.Column="4" Content="Enviar" Height="32" Click="Enviar_Click" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>

    <!-- Gaveta de configurações: desliza da direita. -->
    <Grid x:Name="Gaveta" Visibility="Collapsed">
        <Border Background="#A6000000" MouseLeftButtonDown="FecharGaveta_Click" />
        <Border x:Name="CartaoGaveta" Width="390" HorizontalAlignment="Right" Background="{DynamicResource Cartao}"
                BorderBrush="{StaticResource BordaForte}" BorderThickness="1,0,0,0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DeslocaGaveta" X="390" />
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="22,16,12,6">
                    <TextBlock Text="Configurações" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
                    <Button Content="✕" HorizontalAlignment="Right" Style="{StaticResource BotaoPlano}" Foreground="{StaticResource Suave}"
                            ToolTip="Fechar (Esc)" Click="FecharGaveta_Click" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,8,22,24">
                        <TextBlock Text="Streamer.bot (WebSocket)" FontWeight="Bold" FontSize="14" Margin="0,4,0,10" />
                        <TextBlock Text="Endereço" Style="{StaticResource Rotulo}" />
                        <TextBox x:Name="TxtSbUrl" Tag="ws://127.0.0.1:8080" Margin="0,0,0,10" />
                        <TextBlock Text="Senha" Style="{StaticResource Rotulo}" />
                        <PasswordBox x:Name="PwdSbSenha" Margin="0,0,0,8" />
                        <TextBlock Text="É a senha do servidor WebSocket do Streamer.bot (Servers/Clients). Ao fechar, mudanças no endereço ou na senha reconectam." Foreground="{StaticResource Suave}"
                                   FontSize="12" TextWrapping="Wrap" />

                        <Border Height="1" Background="{StaticResource Borda}" Margin="0,22,0,18" />
                        <TextBlock Text="OBS (WebSocket)" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />
                        <TextBlock Text="Endereço" Style="{StaticResource Rotulo}" />
                        <TextBox x:Name="TxtObsUrl" Tag="ws://127.0.0.1:4455" Margin="0,0,0,10" />
                        <TextBlock Text="Senha" Style="{StaticResource Rotulo}" />
                        <PasswordBox x:Name="PwdObsSenha" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnObs" Content="Desconectar" Click="Obs_Click" Padding="16,7" />
                            <TextBlock x:Name="EstadoObs" Grid.Column="1" Foreground="{StaticResource Suave}" FontSize="12.5" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>
                        <TextBlock Text="Ao fechar, mudanças no endereço ou na senha reconectam o OBS." Foreground="{StaticResource Suave}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />

                        <Border Height="1" Background="{StaticResource Borda}" Margin="0,22,0,18" />
                        <TextBlock Text="Transmissão" FontWeight="Bold" FontSize="14" Margin="0,0,0,12" />
                        <CheckBox x:Name="OpControles" Content="Botões de iniciar e encerrar a live e a gravação" Tag="controles" Style="{StaticResource Interruptor}"
                                  Checked="Opcao_Changed" Unchecked="Opcao_Changed" />
                        <TextBlock Text="Vêm desligados, para não encerrar a transmissão sem querer. Quando ligados, aparecem no painel Saúde da transmissão (a chave Saúde fica na barra de cima)." Foreground="{StaticResource Suave}"
                                   FontSize="12" TextWrapping="Wrap" />

                        <Border Height="1" Background="{StaticResource Borda}" Margin="0,22,0,18" />
                        <TextBlock Text="Cores" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />
                        <TextBlock Text="Cor de destaque" Style="{StaticResource Rotulo}" />
                        <ItemsControl x:Name="ListaAcentos">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding Hex}" ToolTip="{Binding Nome}" Click="Acento_Click" Width="30" Height="30" Margin="0,0,8,8" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="15" Background="{Binding Hex, Converter={StaticResource PincelDe}}"
                                                        BorderBrush="{StaticResource BordaForte}" BorderThickness="2" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,2,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtCorHex" Tag="#RRGGBB" />
                            <Button Grid.Column="2" Content="Aplicar" Click="AplicarCor_Click" Padding="14,6" />
                        </Grid>
                        <TextBlock x:Name="AvisoCor" Foreground="{StaticResource Aviso}" FontSize="12" Visibility="Collapsed" Margin="0,-8,0,10" />
                        <TextBlock Text="Fundo" Style="{StaticResource Rotulo}" />
                        <ItemsControl x:Name="ListaFundos">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" Tag="{Binding}" Click="Fundo_Click" Margin="0,0,8,8" Padding="12,5" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Height="1" Background="{StaticResource Borda}" Margin="0,16,0,18" />
                        <TextBlock Text="Chat" FontWeight="Bold" FontSize="14" Margin="0,0,0,12" />
                        <CheckBox x:Name="OpEmotes" Content="Emotes do 7TV, BetterTTV e FrankerFaceZ" Tag="emotes" Style="{StaticResource Interruptor}"
                                  Checked="Opcao_Changed" Unchecked="Opcao_Changed" />
                        <TextBlock Text="Os emotes da Twitch e da Kick já aparecem; estes são os de terceiros, do seu canal e os globais." Foreground="{StaticResource Suave}"
                                   FontSize="12" TextWrapping="Wrap" />

                        <Border Height="1" Background="{StaticResource Borda}" Margin="0,16,0,18" />
                        <TextBlock Text="Tamanho da janela" FontWeight="Bold" FontSize="14" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="Padrão" Click="EscalaPadrao_Click" Padding="12,8" ToolTip="Janela comum no centro da tela, sem tela cheia" />
                            <Button Grid.Column="2" Content="Ao lado do OBS" Click="EscalaObs_Click" Padding="12,8" ToolTip="Faixa estreita na altura da tela, junto ao OBS" />
                        </Grid>
                        <TextBlock Text="Padrão: janela normal no centro. Ao lado do OBS: faixa estreita na altura da tela, colada à direita do OBS (ou no canto da tela), sempre acima." Foreground="{StaticResource Suave}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />

                        <Border Height="1" Background="{StaticResource Borda}" Margin="0,16,0,18" />
                        <TextBlock Text="Segundo plano" FontWeight="Bold" FontSize="14" Margin="0,0,0,12" />
                        <CheckBox x:Name="OpMinimizar" Content="Minimizar esconde da barra de tarefas" Tag="min" Style="{StaticResource Interruptor}"
                                  Checked="Opcao_Changed" Unchecked="Opcao_Changed" />
                        <CheckBox x:Name="OpFechar" Content="Fechar (X) esconde na bandeja" Tag="fechar" Style="{StaticResource Interruptor}"
                                  Checked="Opcao_Changed" Unchecked="Opcao_Changed" />
                        <CheckBox x:Name="OpEscondido" Content="Abrir já escondido" Tag="escondido" Style="{StaticResource Interruptor}"
                                  Checked="Opcao_Changed" Unchecked="Opcao_Changed" />
                        <CheckBox x:Name="OpTopo" Content="Manter acima das outras janelas" Tag="topo" Style="{StaticResource Interruptor}"
                                  Checked="Opcao_Changed" Unchecked="Opcao_Changed" />
                        <TextBlock Text="Ctrl+Alt+P mostra ou esconde o painel de qualquer lugar." Foreground="{StaticResource Suave}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
    </Grid>
</Window>
